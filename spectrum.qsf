set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME testbench -section_id testbench
set_global_assignment -name EDA_TEST_BENCH_FILE testbench.v -section_id testbench
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_location_assignment PIN_24 -to clk
set_location_assignment PIN_1 -to led
# =============================================================================
# FT232H Synchronous 245 FIFO Interface Pin Assignments
# =============================================================================

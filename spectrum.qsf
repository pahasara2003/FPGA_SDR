set_location_assignment PIN_59 -to ft_data[3]
set_location_assignment PIN_60 -to ft_data[4]
set_location_assignment PIN_64 -to ft_data[5]
set_location_assignment PIN_65 -to ft_data[6]
set_location_assignment PIN_66 -to ft_data[7]




